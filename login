<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="styles/style.css" />
    <link rel="icon" type="onixlogo" href="favicon.ico">

    <!-- Primary Meta Tags -->
    <title>Onix Client Login</title>
    <meta name="title" content="Onix Client Login" />
    <meta name="description" content="Login to Onix Client Premium!" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://onixclient.com/login" />
    <meta property="og:title" content="Onix Client Login" />
    <meta property="og:description" content="Login to Onix Client Premium!" />
    <meta property="og:image" content="https://onixclient.com/assets/biglogo.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://onixclient.com/login" />
    <meta property="twitter:title" content="Onix Client Login" />
    <meta property="twitter:description" content="Login to Onix Client Premium!" />
    <meta property="twitter:image" content="https://onixclient.com/assets/biglogo.png" />

    <style>
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        iframe {
            display: block;
            width: 100%;
            height: 100%;
            border: 0;
        }
    </style>
</head>

<body>
    <iframe
        src="https://api.onixclient.com/login"
